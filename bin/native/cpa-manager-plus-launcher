elif [ -n "${CPAMP_GATEWAY_URL:-}" ]; then
  cpa_addr="$(extract_host_port_from_url "${CPAMP_GATEWAY_URL}")"
elif [ -n "${CPA_UPSTREAM_URL:-}" ]; then
  cpa_addr="$(extract_host_port_from_url "${CPA_UPSTREAM_URL}")"
else
  cpa_addr="127.0.0.1:8317"
fi

runtime_port="$(require_loopback_address "Runtime Supervisor" "${runtime_addr}")"
manager_port="$(require_loopback_address "Manager Server" "${manager_addr}")"
ingress_control_port="$(require_loopback_address "Ingress Control" "${ingress_control_addr}")"
cpa_port="$(require_loopback_address "CPA Gateway" "${cpa_addr}")"
cpa_host="$(printf '%s\n' "$(split_host_port "${cpa_addr}")" | sed -n '1p')"
cpa_host="${cpa_host#[}"
cpa_host="${cpa_host%]}"

# Ensure no port collisions across the 5 listeners
seen_ports=":"
for port_entry in \
  "ingress:${ingress_port}" \
  "runtime-supervisor:${runtime_port}" \
  "manager:${manager_port}" \
  "ingress-control:${ingress_control_port}" \
  "cpa:${cpa_port}"; do
  p_val="${port_entry#*:}"
  if [[ "${seen_ports}" == *":${p_val}:"* ]]; then
    log_err "Port collision detected in native launcher configuration on port ${p_val}"
    exit 1
  fi
  seen_ports="${seen_ports}${p_val}:"
done

# Persist the resolved CPA address next to the other 0600 runtime records so
# `cpa-manager-plusctl` targets exactly the listener this launcher configured,
# even when the caller's shell does not repeat the override and even though the
# default 8317 is only one of five accepted inputs.
cpa_address_file="${run_dir}/cpa.address"
reject_unsafe_runtime_file "${cpa_address_file}"
cpa_address_tmp="${cpa_address_file}.tmp.$$"
prepare_private_file "${cpa_address_tmp}"
printf '%s\n' "${cpa_addr}" >"${cpa_address_tmp}"
chmod 600 "${cpa_address_tmp}"
mv -f "${cpa_address_tmp}" "${cpa_address_file}"
chmod 600 "${cpa_address_file}"

runtime_identity="${CPAMP_RUNTIME_IDENTITY:-embedded-default}"
runtime_url="${CPAMP_RUNTIME_URL:-http://${runtime_addr}}"
manager_url="${CPAMP_MANAGER_URL:-http://${manager_addr}}"
gateway_url="${CPAMP_GATEWAY_URL:-http://${cpa_addr}}"
cpa_upstream_url="${CPA_UPSTREAM_URL:-http://${cpa_addr}}"
ingress_control_url="${CPAMP_INGRESS_CONTROL_URL:-http://${ingress_control_addr}}"
public_origin="${CPAMP_PUBLIC_ORIGIN:-}"

db_path="${USAGE_DB_PATH:-"${data_dir}/usage.sqlite"}"
data_key_path="${CPA_MANAGER_DATA_KEY_PATH:-"${data_dir}/data.key"}"

cpa_manifest="${CPAMP_CPA_ARTIFACT_MANIFEST:-}"
if [ -z "${cpa_manifest}" ] && [ -f "${home_dir}/share/cpamp/runtime/cpa-artifact.json" ]; then
  cpa_manifest="${home_dir}/share/cpamp/runtime/cpa-artifact.json"
fi

# Seed initial Gateway config if seed template exists and gateway config is absent.
# The bootstrap Gateway is never an admission surface: Ingress refuses Gateway
# traffic until Fresh activation, and Fresh staging replaces this file with the
# Manager-generated client key. It must still never carry an empty client-key
# list, because CPA treats that as "client authentication disabled" and this
# host's loopback listener is reachable by every local account.
seed_config="${home_dir}/share/cpamp/runtime/config.seed.yaml"
gateway_config="${gateway_dir}/config.yaml"
bootstrap_gateway_key_file="${run_dir}/gateway-bootstrap-key"
if [ -f "${seed_config}" ] && [ ! -e "${gateway_config}" ] && [ ! -L "${gateway_config}" ]; then
  # Root seeds this file only while gateway_dir is root-owned. At runtime the
  # directory belongs to cpamp-cpa, so writing through a tree the unprivileged
  # child controls would let it redirect the write at a root-owned file (NH3).
  if [ "$(id -u)" -eq 0 ] && { ! chown -h 0:0 "${gateway_dir}" || ! chmod 0700 "${gateway_dir}"; }; then
    log_err "Failed to take temporary ownership of ${gateway_dir} before seeding ${gateway_config}"
    exit 1
  fi
  config_tmp="${gateway_config}.tmp.$$"
  prepare_private_file "${config_tmp}"

  sed_escape_replacement() {
    printf '%s' "$1" | sed -e 's/[\\|&]/\\&/g'
  }
  escaped_cpa_port="$(sed_escape_replacement "${cpa_port}")"
  escaped_auth_dir="$(sed_escape_replacement "${gateway_dir}/auth")"
  escaped_plugin_dir="$(sed_escape_replacement "${gateway_dir}/plugins")"
  escaped_cpa_host="$(sed_escape_replacement "${cpa_host}")"

  if grep -q 'api-keys: \[\]' "${seed_config}"; then
    gateway_bootstrap_key="$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    key_tmp="${bootstrap_gateway_key_file}.tmp.$$"
    prepare_private_file "${key_tmp}"
    printf '%s' "${gateway_bootstrap_key}" >"${key_tmp}"
    chmod 0600 "${key_tmp}"
    mv -f "${key_tmp}" "${bootstrap_gateway_key_file}"
    chmod 0600 "${bootstrap_gateway_key_file}"
    sed \
      -e "s|port: 8317|port: ${escaped_cpa_port}|g" \
      -e "s|host: \"127.0.0.1\"|host: \"${escaped_cpa_host}\"|g" \
      -e "s|/runtime/gateway/auth|${escaped_auth_dir}|g" \
      -e "s|/runtime/gateway/plugins|${escaped_plugin_dir}|g" \
      -e "s|api-keys: \[\]|api-keys: [\"${gateway_bootstrap_key}\"]|" \
      "${seed_config}" >"${config_tmp}"
  else
    sed \
      -e "s|port: 8317|port: ${escaped_cpa_port}|g" \
      -e "s|host: \"127.0.0.1\"|host: \"${escaped_cpa_host}\"|g" \
      -e "s|/runtime/gateway/auth|${escaped_auth_dir}|g" \
      -e "s|/runtime/gateway/plugins|${escaped_plugin_dir}|g" \
      "${seed_config}" >"${config_tmp}"
  fi
  chmod 0600 "${config_tmp}"
  mv -f "${config_tmp}" "${gateway_config}"
fi

apply_cpa_ownership

runtime_pid_file="${run_dir}/runtime-supervisor.pid"
manager_pid_file="${run_dir}/manager.pid"
ingress_pid_file="${run_dir}/ingress.pid"
ready_file="${run_dir}/launcher.ready"
# Root-owned pin of (pid, start time) for every CPA child this launcher observed.
cpa_provenance_file="${run_dir}/cpa-instance.provenance"

runtime_pid=""
manager_pid=""
ingress_pid=""
shutting_down=0
provenance_refresh_at=0

check_runtime_ready() {
  local pid="$1"
  local code

  # Never send the Runtime bearer to an unproven listener: loopback is shared
  # with every local account, so an impostor could capture it.
  if ! process_listens_on_port "${pid}" "${runtime_port}"; then
    return 1
  fi

  code="$(http_status_code "http://${runtime_addr}/v1/runtime/status" "${runtime_token}" "X-CPAMP-Runtime-Features: active-gateway-artifact-v1")"
  if [ "${code}" = "200" ]; then
    return 0
  fi
  if [ "${code}" = "404" ]; then
    code="$(http_status_code "http://${runtime_addr}/health")"
    [ "${code}" = "200" ] && return 0
  fi
  return 1
}

check_manager_ready() {
  local pid="$1"
  local code

  if ! process_listens_on_port "${pid}" "${manager_port}"; then
    return 1
  fi

  code="$(http_status_code "http://${manager_addr}/health")"
  if [ "${code}" = "200" ]; then
    return 0
  fi
  if [ "${code}" = "503" ]; then
    local disc_code
    disc_code="$(http_status_code "http://${manager_addr}/.well-known/cpamp-bootstrap")"
    [ "${disc_code}" = "200" ] && return 0
  fi
  return 1
}

check_ingress_ready() {
  local pid="$1"
  local code

  if ! process_listens_on_port "${pid}" "${ingress_port}"; then
    return 1
  fi
  if ! process_listens_on_port "${pid}" "${ingress_control_port}"; then
    return 1
  fi

  code="$(http_status_code "http://${ingress_probe_host}:${ingress_port}/health")"
  if [ "${code}" = "200" ]; then
    return 0
  fi
  if [ "${code}" = "503" ]; then
    local ctrl_code
    ctrl_code="$(http_status_code "http://${ingress_control_addr}/internal/routing/fresh")"
    if [ "${ctrl_code}" = "200" ] || [ "${ctrl_code}" = "404" ]; then
      return 0
    fi
  fi
  return 1
}

stop_child_process() {
  local name="$1"
  local pid="$2"
  local child_pid_file="$3"
  local deadline="$4"
  local waited=0

  if [ -n "${pid}" ] && is_pid_running "${pid}"; then
    log_msg "Stopping ${name} (PID ${pid})"
    kill -TERM "${pid}" >/dev/null 2>&1 || true
    while is_pid_running "${pid}"; do
      if [ "$(date +%s)" -ge "${deadline}" ]; then
        break
      fi
      sleep 0.1
    done
    if is_pid_running "${pid}"; then
      log_err "${name} (PID ${pid}) did not exit within the ${stop_timeout_sec}s shutdown budget; sending SIGKILL"
      kill -KILL "${pid}" >/dev/null 2>&1 || true
    fi
    # `wait` blocks for as long as the child is still alive (an unkillable
    # D-state process would otherwise hang shutdown forever), so it is only
    # called once the process is gone, and the reap is additionally bounded.
    waited=0
    while is_pid_running "${pid}" && [ "${waited}" -lt 50 ]; do
      sleep 0.1
      waited=$((waited + 1))
    done
    if ! is_pid_running "${pid}"; then
      wait "${pid}" 2>/dev/null || true
    else
      log_err "${name} (PID ${pid}) is still alive after SIGKILL; leaving it for the operator"
    fi
  fi
  rm -f "${child_pid_file}"
}

shutdown_all_children() {
  # One shutdown budget covers all three children so systemd's TimeoutStopSec
  # can never expire in the middle of the sequence.
  local deadline
  deadline=$(( $(date +%s) + stop_timeout_sec ))

  rm -f "${ready_file}"
  # Pin the CPA children while their Supervisor is still alive; after it is
  # stopped they are reparented and only the recorded identity remains.
  refresh_cpa_instance_provenance
  # Reverse dependency order: Ingress -> Manager Server -> Runtime Supervisor
  stop_child_process "ingress" "${ingress_pid}" "${ingress_pid_file}" "${deadline}"
  ingress_pid=""
  stop_child_process "manager" "${manager_pid}" "${manager_pid_file}" "${deadline}"
  manager_pid=""
  stop_child_process "runtime-supervisor" "${runtime_pid}" "${runtime_pid_file}" "${deadline}"
  runtime_pid=""
  stop_orphaned_cpa_processes "${deadline}"
  rm -f "${pid_file}"
}

handle_shutdown_signal() {
  local sig="$1"
  if [ "${shutting_down}" -eq 1 ]; then
    return 0
  fi
  shutting_down=1
  # A signalled shutdown is not a failure: nothing below may abort on an error
  # (a child already gone, a port that just closed, an interrupted `wait`) and
  # leak its status as the launcher's exit code.
  set +e
  log_msg "Received SIG${sig}; shutting down 3-process stack in reverse dependency order"
  shutdown_all_children
  exit 0
}

# Startup aborts degrade to a success status when the abort was requested by a
# shutdown signal, so `systemctl stop` during startup still exits 0.
abort_startup() {
  shutdown_all_children
  if [ "${shutting_down}" -eq 1 ]; then
    log_msg "Startup interrupted by a shutdown signal; exiting 0"
    exit 0
  fi
  exit 1
}

handle_reload_signal() {
  log_msg "Received SIGHUP; the native stack has no reloadable configuration and keeps running"
}

trap 'handle_shutdown_signal TERM' TERM
trap 'handle_shutdown_signal INT' INT
trap 'handle_reload_signal' HUP

wait_for_child_readiness() {
  local name="$1"
  local pid="$2"
  local check_fn="$3"
  local max_ticks=$((startup_timeout_sec * 10))
  local tick=0

  while [ "${tick}" -lt "${max_ticks}" ]; do
    if [ "${shutting_down}" -eq 1 ]; then
      return 1
    fi
    if ! is_pid_running "${pid}"; then
      log_err "${name} (PID ${pid}) exited prematurely before becoming ready"
      return 1
    fi
    if [ -n "${runtime_pid}" ] && [ "${pid}" != "${runtime_pid}" ] && ! is_pid_running "${runtime_pid}"; then
      log_err "runtime-supervisor (PID ${runtime_pid}) exited while waiting for ${name}"
      return 1
    fi
    if [ -n "${manager_pid}" ] && [ "${pid}" != "${manager_pid}" ] && ! is_pid_running "${manager_pid}"; then
      log_err "manager (PID ${manager_pid}) exited while waiting for ${name}"
      return 1
    fi
    if "${check_fn}" "${pid}"; then
      return 0
    fi
    sleep 0.1
    tick=$((tick + 1))
  done

  log_err "Timed out after ${startup_timeout_sec}s waiting for ${name} (PID ${pid}) readiness"
  return 1
}

spawn_runtime_supervisor() {
  # A replacement Supervisor builds an incarnation-local child manager and never
  # adopts a previously started CPA, so the old child must be gone (and the port
  # provably free) before it starts.
  if ! prepare_cpa_listener_for_supervisor "refusing to start a replacement runtime-supervisor and stopping the stack"; then
    return 1
  fi
  assert_listener_port_available "runtime-supervisor" "${runtime_addr}"
  log_msg "Starting runtime-supervisor on ${runtime_addr} (CPA loopback ${cpa_addr})"
  (
    cd "${gateway_dir}"
    export CPAMP_RUNTIME_ADDR="${runtime_addr}"
    export CPAMP_RUNTIME_IDENTITY="${runtime_identity}"
    export CPAMP_RUNTIME_TOKEN="${runtime_token}"
    export CPAMP_RUNTIME_TOKEN_FILE="${token_file}"
    export CPAMP_RUNTIME_JOURNAL_PATH="${journal_path}"
    export CPAMP_RUNTIME_CPA_ADDR="${cpa_addr}"
    export CPAMP_RUNTIME_CPA_LISTEN_LOOPBACK=1
    export CPAMP_CPA_EXECUTABLE="${cpa_bin}"
    if [ -n "${cpa_uid}" ]; then
      export CPAMP_RUNTIME_CPA_UID="${cpa_uid}"
      export CPAMP_RUNTIME_CPA_GID="${cpa_gid}"
    fi
    if [ -n "${cpa_manifest}" ]; then
      export CPAMP_CPA_ARTIFACT_MANIFEST="${cpa_manifest}"
    fi
    exec "${runtime_bin}"
  ) >>"${log_file}" 2>&1 &
  runtime_pid="$!"

  if ! wait_for_child_readiness "runtime-supervisor" "${runtime_pid}" check_runtime_ready; then
    return 1
  fi
  write_pid_record_to "${runtime_pid_file}" "${runtime_pid}"
  log_msg "runtime-supervisor ready (PID ${runtime_pid})"
}

spawn_manager_server() {
  assert_listener_port_available "manager" "${manager_addr}"
  if [ -z "${public_origin}" ]; then
    log_msg "CPAMP_PUBLIC_ORIGIN is unset: browser origin checks fall back to each request Host (Compose parity) and Fresh routing stays disabled until it names the external URL"
  fi
  log_msg "Starting manager on ${manager_addr}"
  (
    cd "${home_dir}"
    unset CPAMP_RUNTIME_TOKEN CPAMP_RUNTIME_CPA_LISTEN_LOOPBACK
    export HTTP_ADDR="${manager_addr}"
    export USAGE_DATA_DIR="${data_dir}"
    export USAGE_DB_PATH="${db_path}"
    export CPA_MANAGER_DATA_KEY_PATH="${data_key_path}"
    export CPA_UPSTREAM_URL="${cpa_upstream_url}"
    export CPAMP_RUNTIME_URL="${runtime_url}"
    export CPAMP_RUNTIME_TOKEN_FILE="${token_file}"
    export CPAMP_INGRESS_CONTROL_URL="${ingress_control_url}"
    if [ -n "${public_origin}" ]; then
      export CPAMP_PUBLIC_ORIGIN="${public_origin}"
    else
      unset CPAMP_PUBLIC_ORIGIN
    fi
    export USAGE_COLLECTOR_MODE="${USAGE_COLLECTOR_MODE:-auto}"
    export USAGE_RESP_QUEUE="${USAGE_RESP_QUEUE:-usage}"
    export USAGE_RESP_POP_SIDE="${USAGE_RESP_POP_SIDE:-right}"
    export USAGE_BATCH_SIZE="${USAGE_BATCH_SIZE:-100}"
    export USAGE_POLL_INTERVAL_MS="${USAGE_POLL_INTERVAL_MS:-500}"
    export USAGE_QUERY_LIMIT="${USAGE_QUERY_LIMIT:-50000}"
    export USAGE_CORS_ORIGINS="${USAGE_CORS_ORIGINS:-*}"
    exec "${manager_bin}"
  ) >>"${log_file}" 2>&1 &
  manager_pid="$!"

  if ! wait_for_child_readiness "manager" "${manager_pid}" check_manager_ready; then
    return 1
  fi
  write_pid_record_to "${manager_pid_file}" "${manager_pid}"
  log_msg "manager ready (PID ${manager_pid})"
}

spawn_ingress() {
  assert_listener_port_available "ingress" "${ingress_addr}"
  assert_listener_port_available "ingress-control" "${ingress_control_addr}"
  log_msg "Starting ingress on ${ingress_addr} (control ${ingress_control_addr})"
  (
    cd "${home_dir}"
    unset CPAMP_RUNTIME_TOKEN CPAMP_RUNTIME_CPA_LISTEN_LOOPBACK
    export CPAMP_INGRESS_ADDR="${ingress_addr}"
    export CPAMP_MANAGER_URL="${manager_url}"
    export CPAMP_GATEWAY_URL="${gateway_url}"
    export CPAMP_INGRESS_CONTROL_ADDR="${ingress_control_addr}"
    exec "${ingress_bin}"
  ) >>"${log_file}" 2>&1 &
  ingress_pid="$!"

  if ! wait_for_child_readiness "ingress" "${ingress_pid}" check_ingress_ready; then
    return 1
  fi
  write_pid_record_to "${ingress_pid_file}" "${ingress_pid}"
  log_msg "ingress ready (PID ${ingress_pid})"
}

write_ready_state() {
  local tmp_ready="${ready_file}.tmp.$$"
  prepare_private_file "${tmp_ready}"
  {
    printf 'launcher_pid=%s\n' "$$"
    printf 'runtime_pid=%s\n' "${runtime_pid}"
    printf 'manager_pid=%s\n' "${manager_pid}"
    printf 'ingress_pid=%s\n' "${ingress_pid}"
    printf 'ingress_addr=%s\n' "${ingress_addr}"
    printf 'manager_addr=%s\n' "${manager_addr}"
    printf 'runtime_addr=%s\n' "${runtime_addr}"
    printf 'ingress_control_addr=%s\n' "${ingress_control_addr}"
    printf 'cpa_addr=%s\n' "${cpa_addr}"
    printf 'token_file=%s\n' "${token_file}"
  } >"${tmp_ready}"
  chmod 0600 "${tmp_ready}"
  mv -f "${tmp_ready}" "${ready_file}"
  chmod 0600 "${ready_file}"
}

rm -f "${ready_file}" "${runtime_pid_file}" "${manager_pid_file}" "${ingress_pid_file}"
write_pid_record_to "${pid_file}" "$$" || true

# A previous incarnation may have left its own CPA child behind. Only an
# attributable child is drained; anything else on the port fails closed.
if ! prepare_cpa_listener_for_supervisor "refusing to start (another local process could capture Runtime traffic)"; then
  exit 1
fi
# The pins describe the previous stack's children; new ones are recorded as the
# monitor loop observes them.
rm -f "${cpa_provenance_file}"
assert_listener_port_available "cpa-gateway" "${cpa_addr}"

if ! spawn_runtime_supervisor; then
  abort_startup
fi

if ! spawn_manager_server; then
  abort_startup
fi

if ! spawn_ingress; then
  abort_startup
fi

write_ready_state
log_msg "All 3 processes started and ready (unified port: ${ingress_addr})"

restart_count=0

while [ "${shutting_down}" -eq 0 ]; do
  crashed_name=""
  crashed_pid=""

  # Re-pin the CPA children of this incarnation once per second so a Supervisor
  # that dies between checks still leaves an attributable record behind.
  now_second="$(date +%s)"
  if [ "${now_second}" != "${provenance_refresh_at}" ]; then
    refresh_cpa_instance_provenance
    provenance_refresh_at="${now_second}"
  fi

  if ! is_pid_running "${runtime_pid}"; then
    crashed_name="runtime-supervisor"
    crashed_pid="${runtime_pid}"
  elif ! is_pid_running "${manager_pid}"; then
    crashed_name="manager"
    crashed_pid="${manager_pid}"
  elif ! is_pid_running "${ingress_pid}"; then
    crashed_name="ingress"
    crashed_pid="${ingress_pid}"
  fi

  if [ -n "${crashed_name}" ] && [ "${shutting_down}" -eq 0 ]; then
    exit_code=0
    wait "${crashed_pid}" 2>/dev/null || exit_code="$?"

    # A shutdown signal that arrived while we were collecting the child status
    # wins: the exit code of an interrupted `wait` (or of a child that was
    # already going away) is not this launcher's status.
    if [ "${shutting_down}" -eq 1 ]; then
      set +e
      shutdown_all_children
      exit 0
    fi

    case "${exit_code}" in
      '' | *[!0-9]*) exit_code=1 ;;
    esac
    if [ "${exit_code}" -eq 0 ]; then
      exit_code=1
    fi

    if [ "${restart_count}" -lt "${max_restarts}" ]; then
      restart_count=$((restart_count + 1))
      log_err "Child ${crashed_name} (PID ${crashed_pid}) exited unexpectedly (code ${exit_code}); restarting (${restart_count}/${max_restarts})"
      restarted_ok=0
      case "${crashed_name}" in
        runtime-supervisor)
          rm -f "${runtime_pid_file}"
          runtime_pid=""
          if spawn_runtime_supervisor; then
            restarted_ok=1
          fi
          ;;
        manager)
          rm -f "${manager_pid_file}"
          manager_pid=""
          if spawn_manager_server; then
            restarted_ok=1
          fi
          ;;
        ingress)
          rm -f "${ingress_pid_file}"
          ingress_pid=""
          if spawn_ingress; then
            restarted_ok=1
          fi
          ;;
      esac

      if [ "${restarted_ok}" -eq 1 ]; then
        write_ready_state
        continue
      fi
    fi

    log_err "Child ${crashed_name} (PID ${crashed_pid}) failed (code ${exit_code}); shutting down remaining processes"
    shutdown_all_children
    exit "${exit_code}"
  fi

  sleep 0.1
done
