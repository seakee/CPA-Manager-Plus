{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPAMP Phase4-03 route ownership contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contractId",
    "fixedBootstrapNamespace",
    "fixedBrandResources",
    "fixedBootstrapDiscoveryPath",
    "canonicalPublicApiV2Suffix",
    "publicApiActivation",
    "snapshotStates",
    "routes",
    "normalization",
    "retiredNamespace"
  ],
  "properties": {
    "$schema": {
      "const": "./route-owners.schema.json"
    },
    "schemaVersion": {
      "const": 3
    },
    "contractId": {
      "const": "cpamp-v2-phase4-03-routing-ownership-v3"
    },
    "fixedBootstrapNamespace": {
      "const": {
        "root": "/.well-known/cpamp-bootstrap",
        "shell": "/.well-known/cpamp-bootstrap/ui",
        "assets": "/.well-known/cpamp-bootstrap/assets/",
        "api": "/.well-known/cpamp-bootstrap/api/v2/",
        "owner": "manager",
        "authentication": "fresh_session_only",
        "loadingGraph": "same_full_web_static_bootstrap_graph",
        "unknownOrAmbiguous": "captured_generic_404",
        "gatewayFallback": "deny",
        "prefixDisclosure": "deny",
        "retirement": "verified_initial_route_commit_generic_404"
      }
    },
    "fixedBrandResources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "methods",
          "blob",
          "mime",
          "cacheControl",
          "missingOrDisabled",
          "nonMatchingRequest"
        ],
        "properties": {
          "path": { "enum": ["/favicon.ico", "/apple-touch-icon.png"] },
          "methods": { "const": ["GET", "HEAD"] },
          "blob": {
            "enum": [
              "ca89e52265a23f82120f18e82864e9565b93dbca",
              "92cfe10552efc4dfbb6066ece5701229f1fd53f3"
            ]
          },
          "mime": { "enum": ["image/x-icon", "image/png"] },
          "cacheControl": { "const": "public, max-age=86400" },
          "missingOrDisabled": { "const": "manager_local_404" },
          "nonMatchingRequest": { "const": "normal_classifier" }
        }
      }
    },
    "fixedBootstrapDiscoveryPath": {
      "const": "/.well-known/cpamp-bootstrap"
    },
    "canonicalPublicApiV2Suffix": {
      "const": "/api/v2"
    },
    "publicApiActivation": {
      "const": "verified_effective_snapshot_only"
    },
    "snapshotStates": {
      "type": "array",
      "const": ["verified_effective", "desired_only", "stale", "unknown", "unavailable"]
    },
    "routes": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "match", "owner", "gatewayFallback"],
        "properties": {
          "id": {
            "enum": [
              "fixed_brand_resources",
              "bootstrap_discovery",
              "public_api_v2_namespace",
              "retired_control_namespace",
              "legacy_manager_routes",
              "gateway_model_protocol",
              "unknown_non_control_path"
            ]
          },
          "match": {
            "enum": [
              "exact_fixed_brand_get_head",
              "exact_fixed_path",
              "verified_effective_segment_prefix",
              "previous_verified_segment_prefix",
              "existing_fixed_or_segment_prefix",
              "existing_data_plane_protocol",
              "outside_control_namespaces"
            ]
          },
          "owner": {
            "enum": ["manager", "gateway"]
          },
          "activeMethods": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["GET", "OPTIONS"]
            }
          },
          "unsupportedMethods": {
            "enum": ["manager_local_rejection"]
          },
          "completedBehavior": {
            "enum": ["generic_404"]
          },
          "authority": {
            "enum": ["verified_effective_snapshot_only"]
          },
          "noAuthorityBehavior": {
            "enum": ["inactive_fail_closed"]
          },
          "behavior": {
            "enum": ["deny_only"]
          },
          "reuseBehavior": {
            "enum": ["collision_fail_closed"]
          },
          "compatibility": {
            "enum": ["preserve_existing_setup_management_health_status"]
          },
          "credentialHeaders": {
            "enum": ["do_not_classify"]
          },
          "gatewayFallback": {
            "enum": ["deny", "preserve"]
          }
        }
      },
      "maxItems": 7,
      "uniqueItems": true
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedRequestPath", "reject", "credentialRouting"],
      "properties": {
        "acceptedRequestPath": {
          "const": "decoded_canonical_path_only"
        },
        "reject": {
          "type": "array",
          "minItems": 9,
          "items": {
            "type": "string"
          }
        },
        "credentialRouting": {
          "const": "route_ownership_precedes_credentials"
        }
      }
    },
    "retiredNamespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence", "history", "managerCredentials", "modelTraffic"],
      "properties": {
        "persistence": {
          "const": "none_in_phase4_01"
        },
        "history": {
          "const": "bounded_representation_only"
        },
        "managerCredentials": {
          "const": "never_forward"
        },
        "modelTraffic": {
          "const": "never_forward"
        }
      }
    }
  }
}
