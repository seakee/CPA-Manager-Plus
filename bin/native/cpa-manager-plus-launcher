#!/usr/bin/env bash
set -euo pipefail
umask 077

app_name="cpa-manager-plus"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

resolve_path() {
  local path="$1"
  if command -v realpath >/dev/null 2>&1; then
    realpath "${path}" 2>/dev/null || printf '%s\n' "${path}"
    return
  fi
  if command -v readlink >/dev/null 2>&1; then
    readlink -f "${path}" 2>/dev/null || printf '%s\n' "${path}"
    return
  fi

  if [ -d "${path}" ]; then
    (
      cd "${path}" 2>/dev/null && pwd -P
    ) || printf '%s\n' "${path}"
    return
  fi

  (
    cd "$(dirname "${path}")" 2>/dev/null && printf '%s/%s\n' "$(pwd -P)" "$(basename "${path}")"
  ) || printf '%s\n' "${path}"
}

if [ -n "${CPA_MANAGER_PLUS_HOME:-}" ]; then
  home_dir="$(resolve_path "${CPA_MANAGER_PLUS_HOME}")"
elif [ "$(basename "${script_dir}")" = "bin" ] && {
  [ -e "${script_dir}/cpa-manager-plus" ] ||
    [ -e "${script_dir}/../cpa-manager-plusctl" ] ||
    [ -e "${script_dir}/../cpa-manager-plus.service" ]
}; then
  home_dir="$(cd "${script_dir}/.." && pwd -P)"
else
  home_dir="${script_dir}"
fi

bin_dir="${CPA_MANAGER_PLUS_BIN_DIR:-"${home_dir}/bin"}"
default_data_dir="${home_dir}/data"
default_run_dir="${home_dir}/run"
default_log_dir="${home_dir}/logs"

data_dir="${USAGE_DATA_DIR:-"${CPA_MANAGER_PLUS_DATA_DIR:-"${default_data_dir}"}"}"
run_dir="${CPA_MANAGER_PLUS_RUN_DIR:-"${default_run_dir}"}"
log_dir="${CPA_MANAGER_PLUS_LOG_DIR:-"${default_log_dir}"}"
pid_file="${CPA_MANAGER_PLUS_PID_FILE:-"${run_dir}/${app_name}.pid"}"
log_file="${CPA_MANAGER_PLUS_LOG_FILE:-"${log_dir}/${app_name}.log"}"

manage_data_dir="false"
manage_run_dir="false"
manage_log_dir="false"

if [ -z "${USAGE_DATA_DIR:-}" ] && [ -z "${CPA_MANAGER_PLUS_DATA_DIR:-}" ]; then
  manage_data_dir="true"
fi
if [ -z "${CPA_MANAGER_PLUS_RUN_DIR:-}" ]; then
  manage_run_dir="true"
fi
if [ -z "${CPA_MANAGER_PLUS_LOG_DIR:-}" ]; then
  manage_log_dir="true"
fi

runtime_bin="${CPA_MANAGER_PLUS_RUNTIME_SUPERVISOR_BIN:-"${bin_dir}/cpa-manager-plus-runtime-supervisor"}"
manager_bin="${CPA_MANAGER_PLUS_MANAGER_BIN:-"${CPA_MANAGER_PLUS_BIN:-"${bin_dir}/cpa-manager-plus"}"}"
ingress_bin="${CPA_MANAGER_PLUS_INGRESS_BIN:-"${bin_dir}/cpa-manager-plus-ingress"}"
cpa_bin="${CPAMP_CPA_EXECUTABLE:-"${bin_dir}/cli-proxy-api"}"

startup_timeout_sec="${CPAMP_STARTUP_TIMEOUT_SEC:-30}"
stop_timeout_sec="${CPAMP_STOP_TIMEOUT_SEC:-10}"
max_restarts="${CPAMP_MAX_RESTARTS:-3}"

usage() {
  cat <<EOF
Usage: $(basename "$0") [run|--help]

Starts and supervises the v2 3-process CPA Manager Plus native stack:
  1. Runtime Supervisor (cpa-manager-plus-runtime-supervisor)
  2. Manager Server     (cpa-manager-plus)
  3. Ingress            (cpa-manager-plus-ingress)

Directory layout under CPA_MANAGER_PLUS_HOME (default: ${home_dir}):
  bin/   cpa-manager-plus, cpa-manager-plus-ingress,
         cpa-manager-plus-runtime-supervisor, cli-proxy-api
  data/  Manager SQLite + data.key and Runtime Supervisor state
  run/   0600 runtime-token and process PID records
  logs/  Service logs

Privilege model (matches the Compose runtime):
  Launcher, Runtime Supervisor, Manager and Ingress run as root under
  systemd. Only the third-party CPA child is dropped to a dedicated
  functional identity through CPAMP_RUNTIME_CPA_UID / CPAMP_RUNTIME_CPA_GID
  (the cpamp-cpa account created by cpa-manager-plusctl install, or
  10001:10001 when no such account exists). Private Supervisor state and the
  0600 runtime token stay root-owned; data/runtime/gateway belongs to the CPA
  identity so the child can write its own auth, logs, plugins and config.
  data/ itself is root:<cpa gid> with mode 0710 (traverse only, never list)
  because runtime_root lives inside it, exactly like Docker's 0711 /runtime
  under a 0755 /. Manager files in data/ (usage.sqlite*, data.key,
  usage-archives) stay 0:0 with 0600/0700 and are unreadable to the CPA child.

Trust model and residual risk:
  Native loopback is shared by every local account, unlike a container
  network. The launcher therefore refuses to start when any internal or CPA
  port is already bound, and it sends the Runtime bearer only after the
  listening socket is proven to belong to its own child PID. Residual risk:
  a local user who wins a bind race after that proof, or who is root, can
  still reach the CPA loopback listener. CPA client authentication is never
  disabled: the bootstrap seed is given a generated client key (0600 at
  run/gateway-bootstrap-key) and Fresh staging replaces it with the
  Manager-generated client key.

CPA process provenance:
  The Runtime Supervisor never stops its CPA child, so the launcher reaps it.
  Only a process that proves it belongs to this installation is signalled: it
  must run under the CPA identity, be this installation's cli-proxy-api, and
  carry this instance's runtime config (-config under data/runtime, or the
  Gateway directory as its working directory). Attribution is decided from live
  process state; the pid/start record in run/cpa-instance.provenance is written
  by the launcher as a pin for its own drain, is advisory, and is re-checked
  immediately before any escalation. A same-UID process that merely occupies the
  CPA port, shares a session, or copies this installation's command line is
  never signalled or waited on; start fails closed until an operator clears it.
EOF
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "help" ]; then
  usage
  exit 0
fi

if [ "${1:-}" = "run" ]; then
  shift
fi

log_msg() {
  printf '[cpamp-launcher] %s\n' "$*"
}

log_err() {
  printf '[cpamp-launcher] %s\n' "$*" >&2
}

path_mode() {
  local path="$1"
  if stat -c '%a' "${path}" >/dev/null 2>&1; then
    stat -c '%a' "${path}"
    return
  fi
  stat -f '%Lp' "${path}"
}

is_group_or_world_writable_mode() {
  local mode="$1"
  local perms group other

  perms="${mode}"
  while [ "${#perms}" -lt 3 ]; do
    perms="0${perms}"
  done
  perms="${perms: -3}"
  group="${perms:1:1}"
  other="${perms:2:1}"

  [ $((10#${group} & 2)) -ne 0 ] || [ $((10#${other} & 2)) -ne 0 ]
}

reject_unsafe_custom_dir() {
  local dir="$1"
  local mode

  mode="$(path_mode "${dir}")"
  if is_group_or_world_writable_mode "${mode}"; then
    log_err "Refusing to use unsafe runtime directory: ${dir} must not be group- or world-writable."
    exit 1
  fi
}

reject_unsafe_runtime_file() {
  local file="$1"

  if [ -L "${file}" ]; then
    log_err "Refusing to use symlinked runtime file: ${file}"
    exit 1
  fi

  if [ -e "${file}" ] && [ ! -f "${file}" ]; then
    log_err "Refusing to use non-regular runtime file: ${file}"
    exit 1
  fi
}

# `gateway_dir` is owned and writable by the unprivileged CPA identity at
# runtime. Root must never follow a path inside it: a planted symlink would let
# the child redirect a privileged chown, chmod or write onto any root-owned
# file. The scan runs before root touches the tree and again once root owns it.
reject_symlinks_under() {
  local dir="$1"
  local found

  [ -d "${dir}" ] || return 0
  found="$(find "${dir}" -type l -print 2>/dev/null | sed -n '1p')"
  if [ -n "${found}" ]; then
    log_err "Refusing to continue: ${found} is a symlink inside ${dir}, which belongs to the CPA identity"
    exit 1
  fi
}

is_managed_dir() {
  local dir="$1"
  { [ "${dir}" = "${data_dir}" ] && [ "${manage_data_dir}" = "true" ]; } ||
    { [ "${dir}" = "${run_dir}" ] && [ "${manage_run_dir}" = "true" ]; } ||
    { [ "${dir}" = "${log_dir}" ] && [ "${manage_log_dir}" = "true" ]; }
}

reject_unsafe_runtime_file_parent() {
  local file="$1"
  local parent_dir

  parent_dir="$(dirname "${file}")"
  if [ -z "${parent_dir}" ] || [ ! -e "${parent_dir}" ]; then
    return 0
  fi

  if [ -L "${parent_dir}" ]; then
    log_err "Refusing to use symlinked runtime directory: ${parent_dir}"
    exit 1
  fi

  if [ ! -d "${parent_dir}" ]; then
    log_err "Refusing to use non-directory runtime path: ${parent_dir}"
    exit 1
  fi

  if ! is_managed_dir "${parent_dir}"; then
    reject_unsafe_custom_dir "${parent_dir}"
  fi
}

ensure_private_dir() {
  local dir="$1"
  local manage_existing="${2:-false}"

  if [ -z "${dir}" ]; then
    return 0
  fi

  if [ "${dir}" = "." ]; then
    dir="$(pwd -P)"
  fi

  if [ -e "${dir}" ] || [ -L "${dir}" ]; then
    if [ -L "${dir}" ]; then
      log_err "Refusing to use symlinked runtime directory: ${dir}"
      exit 1
    fi
    if [ ! -d "${dir}" ]; then
      log_err "Refusing to use non-directory runtime path: ${dir}"
      exit 1
    fi
    if [ "${manage_existing}" = "true" ]; then
      chmod 700 "${dir}"
    else
      reject_unsafe_custom_dir "${dir}"
    fi
    return 0
  fi

  (umask 077 && mkdir -p "${dir}")
  chmod 700 "${dir}"
}

prepare_private_file() {
  local file="$1"
  local parent_dir

  reject_unsafe_runtime_file "${file}"
  reject_unsafe_runtime_file_parent "${file}"
  parent_dir="$(dirname "${file}")"
  if [ "${parent_dir}" = "${run_dir}" ]; then
    ensure_private_dir "${parent_dir}" "${manage_run_dir}"
  elif [ "${parent_dir}" = "${log_dir}" ]; then
    ensure_private_dir "${parent_dir}" "${manage_log_dir}"
  elif [ "${parent_dir}" = "${data_dir}" ]; then
    ensure_private_dir "${parent_dir}" "${manage_data_dir}"
  else
    ensure_private_dir "${parent_dir}" "false"
  fi

  (umask 077 && touch "${file}")
  chmod 600 "${file}"
}

validate_runtime_token() {
  local candidate="$1"
  local candidate_bytes

  candidate_bytes="$(printf '%s' "${candidate}" | wc -c | tr -d ' ')"
  case "${candidate}" in
    *[![:graph:]]*)
      log_err "Runtime transport secret must not contain whitespace"
      return 1
      ;;
  esac
  if [ "${candidate_bytes}" -lt 32 ]; then
    log_err "Runtime transport secret must contain at least 32 bytes"
    return 1
  fi
}

extract_host_port_from_url() {
  local raw="$1"
  local stripped="${raw#http://}"
  stripped="${stripped#https://}"
  stripped="${stripped%%/*}"
  printf '%s\n' "${stripped}"
}

split_host_port() {
  local addr="$1"
  local host port
  if [[ "${addr}" =~ ^\[([^]]+)\]:([0-9]+)$ ]]; then
    host="[${BASH_REMATCH[1]}]"
    port="${BASH_REMATCH[2]}"
  elif [[ "${addr}" =~ ^([^:]*):([0-9]+)$ ]]; then
    host="${BASH_REMATCH[1]}"
    port="${BASH_REMATCH[2]}"
  else
    return 1
  fi
  # A port reaches $((...)) and printf '%04X' as a numeric operand; a
  # non-canonical string such as "08317" would be read as octal (or rejected by
  # the shell) instead of the decimal the operator meant, so only canonical
  # decimal spellings are accepted.
  case "${port}" in
    '' | 0*) return 1 ;;
  esac
  if [ "${#port}" -gt 5 ]; then
    return 1
  fi
  if [ "$((10#${port}))" -lt 1 ] || [ "$((10#${port}))" -gt 65535 ]; then
    return 1
  fi
  printf '%s\n%s\n' "${host}" "${port}"
}

require_loopback_address() {
  local label="$1"
  local addr="$2"
  local parsed host port

  if ! parsed="$(split_host_port "${addr}")"; then
    log_err "Invalid internal address for ${label}: ${addr}"
    exit 1
  fi
  host="$(printf '%s\n' "${parsed}" | sed -n '1p')"
  port="$(printf '%s\n' "${parsed}" | sed -n '2p')"

  case "${host}" in
    127.0.0.1 | localhost | "[::1]")
      ;;
    *)
      log_err "Refusing non-loopback internal address for ${label}: ${addr} (must bind 127.0.0.1)"
      exit 1
      ;;
  esac
  printf '%s\n' "${port}"
}

process_start_marker() {
  local pid="$1"
  if [ -r "/proc/${pid}/stat" ]; then
    awk '{print $22}' "/proc/${pid}/stat" 2>/dev/null
    return
  fi
  ps -ww -p "${pid}" -o lstart= 2>/dev/null | awk '{$1=$1;print}'
}

process_executable_path() {
  local pid="$1"
  local resolved_process
  if [ -L "/proc/${pid}/exe" ]; then
    resolved_process="$(resolve_path "/proc/${pid}/exe")"
    [ -n "${resolved_process}" ] && printf '%s\n' "${resolved_process}"
    return
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -a -p "${pid}" -d txt -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1
    return
  fi
}

process_command_line() {
  local pid="$1"
  ps -ww -p "${pid}" -o command= 2>/dev/null | sed 's/^[[:space:]]*//'
}

write_pid_record_to() {
  local target_file="$1"
  local pid="$2"
  local current_binary current_command current_start tmp_file

  current_start="$(process_start_marker "${pid}" || true)"
  current_binary="$(process_executable_path "${pid}" || true)"
  current_command="$(process_command_line "${pid}" || true)"

  if [ -z "${current_start}" ] || { [ -z "${current_binary}" ] && [ -z "${current_command}" ]; }; then
    return 1
  fi

  tmp_file="${target_file}.tmp.$$"
  prepare_private_file "${tmp_file}"
  {
    printf 'pid=%s\n' "${pid}"
    printf 'start=%s\n' "${current_start}"
    printf 'binary=%s\n' "${current_binary}"
    printf 'command=%s\n' "${current_command}"
  } >"${tmp_file}"
  chmod 600 "${tmp_file}"
  mv -f "${tmp_file}" "${target_file}"
  chmod 600 "${target_file}"
}

is_pid_running() {
  local pid="$1"
  [ -n "${pid}" ] && kill -0 "${pid}" >/dev/null 2>&1
}

# Loopback on a native host is shared by every local account, so the launcher
# must prove a listener belongs to its own child before it sends the Runtime
# bearer to it. These helpers return non-zero when that cannot be proven, which
# fails closed: no secret is sent on an unproven connection.
listening_socket_inodes_for_port() {
  local port="$1"
  local hex_port file

  hex_port="$(printf '%04X' "$((10#${port}))")"
  for file in /proc/net/tcp /proc/net/tcp6; do
    [ -r "${file}" ] || continue
    # inode 0 is not an open socket (it is the "unhashed/timewait" placeholder),
    # so it can never prove ownership of a listener.
    awk -v wanted="${hex_port}" '
      NR > 1 && $4 == "0A" && $10 != "0" && $10 != "" {
        count = split($2, parts, ":")
        if (count >= 2 && parts[count] == wanted) print $10
      }
    ' "${file}"
  done
}

pid_owns_socket_inode() {
  local pid="$1"
  local inode="$2"
  local fd readlink_bin

  if [ ! -d "/proc/${pid}/fd" ]; then
    return 1
  fi

  if command -v readlink >/dev/null 2>&1; then
    readlink_bin="readlink"
  else
    return 1
  fi

  for fd in "/proc/${pid}/fd/"*; do
    [ -L "${fd}" ] || continue
    if [ "$("${readlink_bin}" "${fd}" 2>/dev/null || true)" = "socket:[${inode}]" ]; then
      return 0
    fi
  done
  return 1
}

process_listens_on_port() {
  local pid="$1"
  local port="$2"
  local inodes inode listeners

  if [ -n "${pid}" ] && [ -d /proc/net ]; then
    inodes="$(listening_socket_inodes_for_port "${port}")"
    [ -n "${inodes}" ] || return 1
    # Every listening socket on the port must belong to the child. A single
    # foreign listener on the other address family (or a second address) would
    # otherwise satisfy a "some inode is mine" test while `curl` may reach it.
    while IFS= read -r inode; do
      [ -n "${inode}" ] || continue
      if ! pid_owns_socket_inode "${pid}" "${inode}"; then
        return 1
      fi
    done <<<"${inodes}"
    return 0
  fi

  if [ -n "${pid}" ] && command -v lsof >/dev/null 2>&1; then
    listeners="$(lsof -nP -iTCP:"${port}" -sTCP:LISTEN -t 2>/dev/null | sort -u || true)"
    [ -n "${listeners}" ] || return 1
    [ "${listeners}" = "${pid}" ] || return 1
    return 0
  fi

  return 1
}

port_has_listener() {
  local port="$1"
  local output

  if [ -d /proc/net ]; then
    [ -n "$(listening_socket_inodes_for_port "${port}")" ] && return 0
    return 1
  fi

  if command -v lsof >/dev/null 2>&1; then
    output="$(lsof -nP -a -iTCP:"${port}" -sTCP:LISTEN 2>/dev/null || true)"
    [ -n "${output}" ]
    return $?
  fi

  return 1
}

port_accepts_connections() {
  local host="$1"
  local port="$2"

  if (exec 3<>"/dev/tcp/${host}/${port}") 2>/dev/null; then
    return 0
  fi
  return 1
}

listening_pids_for_port() {
  local port="$1"
  local inodes inode pid fd target

  if [ -d /proc/net ]; then
    inodes="$(listening_socket_inodes_for_port "${port}")"
    [ -n "${inodes}" ] || return 0
    for pid in /proc/[0-9]*; do
      pid="${pid#/proc/}"
      [ -d "/proc/${pid}/fd" ] || continue
      for fd in "/proc/${pid}/fd/"*; do
        [ -L "${fd}" ] || continue
        target="$(readlink "${fd}" 2>/dev/null || true)"
        case "${target}" in
          socket:\[*\])
            inode="${target#socket:[}"
            inode="${inode%]}"
            ;;
          *) continue ;;
        esac
        if printf '%s\n' "${inodes}" | grep -qx "${inode}"; then
          printf '%s\n' "${pid}"
          break
        fi
      done
    done
    return 0
  fi

  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -a -iTCP:"${port}" -sTCP:LISTEN -t 2>/dev/null || true
  fi
}

process_owner_uid() {
  local pid="$1"
  ps -o uid= -p "${pid}" 2>/dev/null | tr -d ' ' || true
}

# /proc/<pid>/stat wraps the executable name in parentheses that may contain
# spaces, so the numeric fields are read after stripping the "pid (comm) "
# prefix instead of by fixed column number.
process_stat_field() {
  local pid="$1"
  local field="$2"
  local line

  [ -r "/proc/${pid}/stat" ] || return 1
  line="$(sed 's/^[0-9]* (.*) //' "/proc/${pid}/stat" 2>/dev/null || true)"
  [ -n "${line}" ] || return 1
  printf '%s\n' "${line}" | awk -v field="${field}" '{print $field}'
}

process_parent_pid() {
  local pid="$1"
  local parent=""

  parent="$(process_stat_field "${pid}" 2 || true)"
  if [ -n "${parent}" ]; then
    printf '%s\n' "${parent}"
    return 0
  fi
  ps -o ppid= -p "${pid}" 2>/dev/null | tr -d ' ' || true
}

process_is_descendant_of() {
  local pid="$1"
  local ancestor="$2"
  local current="${pid}"
  local depth=0

  while [ -n "${current}" ] && [ "${depth}" -lt 32 ]; do
    if [ "${current}" = "${ancestor}" ]; then
      return 0
    fi
    case "${current}" in
      0 | 1) return 1 ;;
    esac
    current="$(process_parent_pid "${current}" || true)"
    depth=$((depth + 1))
  done
  return 1
}

# Each argv entry on its own line, so provenance is compared as whole tokens and
# never as a substring of an unrelated command line.
process_argv_tokens() {
  local pid="$1"

  if [ -r "/proc/${pid}/cmdline" ]; then
    tr '\0' '\n' <"/proc/${pid}/cmdline" 2>/dev/null || true
    return 0
  fi
  ps -ww -p "${pid}" -o args= 2>/dev/null | tr ' ' '\n'
}

process_working_directory() {
  local pid="$1"
  local cwd=""

  if [ -L "/proc/${pid}/cwd" ]; then
    cwd="$(resolve_path "/proc/${pid}/cwd")"
    [ -n "${cwd}" ] && printf '%s\n' "${cwd}"
    return 0
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -a -p "${pid}" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1
  fi
}

list_child_pids() {
  local parent="$1"
  local pids=""

  if [ -r "/proc/${parent}/task/${parent}/children" ]; then
    pids="$(tr ' ' '\n' <"/proc/${parent}/task/${parent}/children" 2>/dev/null || true)"
  fi
  # The per-thread `children` list can miss a child forked by another thread of
  # the parent, so the parent/child scan is always unioned in.
  pids="${pids}
$(ps -o pid= -o ppid= -A 2>/dev/null | awk -v parent="${parent}" '$2 == parent { print $1 }')"

  printf '%s\n' "${pids}" | sed '/^[[:space:]]*$/d' | sort -u
}

# The Supervisor deliberately never stops its CPA child (its Close contract says
# so); a container runtime reaps the process tree instead. Natively the launcher
# must do it, or `ctl stop` would report success while the Gateway keeps
# serving. Merely listening on the CPA port, or merely carrying the CPA binary
# path somewhere in argv, is not evidence that the process belongs to this
# installation, so an instance-scoped tuple is required instead:
#
#   1. it runs under the expected CPA identity,
#   2. its entry point is this installation's CPA executable, and
#   3. its runtime configuration is this installation's - either the
#      `-config <runtime_root>/.../config.yaml` the Supervisor passes, or the
#      ${runtime_root} working directory the bootstrap start inherits.
cpa_process_matches_instance() {
  local pid="$1"
  local owner exe cwd token previous
  local entry_ok=0
  local config_ok=0

  [ -n "${runtime_root}" ] || return 1
  [ -n "${pid}" ] || return 1
  [ "${pid}" = "$$" ] && return 1
  is_pid_running "${pid}" || return 1

  owner="$(process_owner_uid "${pid}")"
  [ -n "${owner}" ] || return 1
  if [ -n "${cpa_uid}" ]; then
    [ "${owner}" = "${cpa_uid}" ] || return 1
  else
    # No dedicated identity configured (non-root launcher): only our own
    # processes can be claimed, never another account's listener.
    [ "${owner}" = "$(id -u)" ] || return 1
  fi

  exe="$(process_executable_path "${pid}" || true)"
  if [ -n "${exe}" ] && [ "${exe}" = "${cpa_bin}" ]; then
    entry_ok=1
  fi

  previous=""
  while IFS= read -r token; do
    if [ "${entry_ok}" -eq 0 ] && [ "${token}" = "${cpa_bin}" ]; then
      entry_ok=1
    fi
    case "${token}" in
      -config=*)
        case "${token#-config=}" in
          "${runtime_root}"/*) config_ok=1 ;;
        esac
        ;;
      *)
        if [ "${previous}" = "-config" ]; then
          case "${token}" in
            "${runtime_root}"/*) config_ok=1 ;;
          esac
        fi
        ;;
    esac
    previous="${token}"
  done <<<"$(process_argv_tokens "${pid}")"

  if [ "${config_ok}" -eq 0 ]; then
    cwd="$(process_working_directory "${pid}" || true)"
    case "${cwd}" in
      "${runtime_root}" | "${runtime_root}"/*) config_ok=1 ;;
    esac
  fi

  [ "${entry_ok}" -eq 1 ] && [ "${config_ok}" -eq 1 ]
}

cpa_provenance_record_start() {
  local wanted="$1"
  local record_pid record_start record_rest

  [ -f "${cpa_provenance_file}" ] || return 1
  while IFS='|' read -r record_pid record_start record_rest; do
    case "${record_pid}" in
      '' | '#'* | instance) continue ;;
    esac
    if [ "${record_pid}" = "${wanted}" ]; then
      printf '%s\n' "${record_start}"
      return 0
    fi
  done <"${cpa_provenance_file}"
  return 1
}

write_cpa_provenance_records() {
  local content="$1"
  local payload existing tmp_file

  [ -d "${run_dir}" ] || return 0
  payload="$(printf 'instance|%s\n%s' "${runtime_root}" "${content}")"
  if [ -f "${cpa_provenance_file}" ] && [ ! -L "${cpa_provenance_file}" ]; then
    existing="$(cat "${cpa_provenance_file}" 2>/dev/null || true)"
    if [ "${existing}" = "${payload}" ]; then
      return 0
    fi
  fi

  tmp_file="${cpa_provenance_file}.tmp.$$"
  prepare_private_file "${tmp_file}"
  printf '%s\n' "${payload}" >"${tmp_file}"
  chmod 600 "${tmp_file}"
  mv -f "${tmp_file}" "${cpa_provenance_file}"
  chmod 600 "${cpa_provenance_file}"
}

# Pins (pid, start time) for every CPA child this launcher can currently see, so
# a child that outlives its Supervisor (and is reparented to init) stays
# attributable without ever trusting a bare port listener. A record survives
# only while the recorded process is alive with the same start time, so a reused
# PID can never inherit an earlier pin.
refresh_cpa_instance_provenance() {
  local pid marker content="" known=" " record_pid record_start record_rest

  [ -n "${runtime_root}" ] || return 0
  [ -d "${run_dir}" ] || return 0

  if [ -f "${cpa_provenance_file}" ]; then
    while IFS='|' read -r record_pid record_start record_rest; do
      case "${record_pid}" in
        '' | '#'* | instance) continue ;;
      esac
      [ -n "${record_start}" ] || continue
      is_pid_running "${record_pid}" || continue
      marker="$(process_start_marker "${record_pid}" || true)"
      [ "${marker}" = "${record_start}" ] || continue
      content="${content}${record_pid}|${marker}
"
      known="${known}${record_pid} "
    done <"${cpa_provenance_file}"
  fi

  if [ -n "${runtime_pid}" ] && is_pid_running "${runtime_pid}"; then
    for pid in $(list_child_pids "${runtime_pid}"); do
      case "${known}" in
        *" ${pid} "*) continue ;;
      esac
      if ! cpa_process_matches_instance "${pid}"; then
        continue
      fi
      marker="$(process_start_marker "${pid}" || true)"
      [ -n "${marker}" ] || continue
      content="${content}${pid}|${marker}
"
      known="${known}${pid} "
    done
  fi

  write_cpa_provenance_records "${content}"
}

# A candidate is attributable only when the instance tuple holds and the process
# is bound to a concrete identity: either a pin this launcher recorded earlier
# (re-checked against the live start time) or a live descendant of this
# incarnation's Supervisor. A shared session or process group is deliberately not
# provenance: every process a host starts from the same shell shares it, so it
# would re-admit the same-UID lookalike this check exists to reject.
cpa_process_is_instance_owned() {
  local pid="$1"
  local recorded

  cpa_process_matches_instance "${pid}" || return 1

  recorded="$(cpa_provenance_record_start "${pid}" || true)"
  if [ -n "${recorded}" ]; then
    [ "${recorded}" = "$(process_start_marker "${pid}" || true)" ]
    return $?
  fi

  if [ -n "${runtime_pid}" ] && process_is_descendant_of "${pid}" "${runtime_pid}"; then
    return 0
  fi
  return 1
}

collect_orphan_cpa_pids() {
  local pids

  pids="$(listening_pids_for_port "${cpa_port}")"
  # The entry point travels through the environment: passing it as an awk
  # operand would make the collector's own command line a substring match and
  # every shutdown would report itself.
  pids="${pids}
$(
    ps -eo pid=,args= 2>/dev/null |
      CPAMP_CPA_ENTRY_POINT="${cpa_bin}" awk '
        index($0, ENVIRON["CPAMP_CPA_ENTRY_POINT"]) == 0 { next }
        { print $1 }
      '
  )"

  printf '%s\n' "${pids}" | sed '/^[[:space:]]*$/d' | sort -u
}

stop_orphaned_cpa_processes() {
  local deadline="$1"
  local pids pid eligible_pids="" remaining

  # Pin anything that still hangs off the Supervisor before it is stopped; the
  # pin is what keeps a reparented child attributable afterwards.
  refresh_cpa_instance_provenance

  pids="$(collect_orphan_cpa_pids)"
  [ -n "${pids}" ] || return 0

  for pid in ${pids}; do
    if ! cpa_process_is_instance_owned "${pid}"; then
      log_err "Refusing to signal PID ${pid} on ${cpa_addr}: it cannot be attributed to this installation (uid $(process_owner_uid "${pid}")); operator intervention required"
      continue
    fi
    eligible_pids="${eligible_pids}${pid}
"
    log_msg "Stopping orphaned CPA child (PID ${pid}) on ${cpa_addr}"
    kill -TERM "${pid}" >/dev/null 2>&1 || true
  done

  [ -n "${eligible_pids}" ] || return 0

  while [ "$(date +%s)" -lt "${deadline}" ]; do
    remaining=0
    for pid in ${eligible_pids}; do
      if is_pid_running "${pid}"; then
        remaining=1
      fi
    done
    [ "${remaining}" -eq 0 ] && return 0
    sleep 0.1
  done

  for pid in ${eligible_pids}; do
    if is_pid_running "${pid}"; then
      # Re-validate the exact same identity on the exact same PID: a PID reused
      # after the SIGTERM must never receive this launcher's SIGKILL.
      if ! cpa_process_is_instance_owned "${pid}"; then
        log_err "Refusing to SIGKILL PID ${pid} on ${cpa_addr}: its instance provenance no longer matches"
        continue
      fi
      log_err "Orphaned CPA child (PID ${pid}) did not exit within the shutdown budget; sending SIGKILL"
      kill -KILL "${pid}" >/dev/null 2>&1 || true
    fi
  done
}

cpa_port_is_free() {
  if port_has_listener "${cpa_port}"; then
    return 1
  fi
  if port_accepts_connections "${cpa_host}" "${cpa_port}"; then
    return 1
  fi
  return 0
}

# `runtime-supervisor` never stops CPA on exit and builds an incarnation-local
# child manager, so a Supervisor that died unexpectedly can leave its old CPA
# child serving on our configured port while a replacement would start without
# owning it. Drain every attributable child and only accept a replacement once
# the port is provably free; an unattributable occupant fails closed.
prepare_cpa_listener_for_supervisor() {
  local context="$1"
  local deadline

  deadline=$(( $(date +%s) + stop_timeout_sec ))
  stop_orphaned_cpa_processes "${deadline}"

  if ! cpa_port_is_free; then
    log_err "CPA port ${cpa_addr} is already bound by a process that cannot be attributed to this installation; ${context}"
    return 1
  fi
  return 0
}

require_port_available() {
  local label="$1"
  local host="$2"
  local port="$3"

  if port_has_listener "${port}" || port_accepts_connections "${host}" "${port}"; then
    log_err "Refusing to start: ${label} port ${host}:${port} is already bound; another local process could capture Runtime traffic"
    exit 1
  fi
}

assert_listener_port_available() {
  local label="$1"
  local addr="$2"
  local parsed host port

  parsed="$(split_host_port "${addr}")" || {
    log_err "Invalid internal address for ${label}: ${addr}"
    exit 1
  }
  host="$(printf '%s\n' "${parsed}" | sed -n '1p')"
  port="$(printf '%s\n' "${parsed}" | sed -n '2p')"
  host="${host#[}"
  host="${host%]}"
  case "${host}" in
    "" | "0.0.0.0" | "::") host="127.0.0.1" ;;
  esac
  require_port_available "${label}" "${host}" "${port}"
}

probe_implementation() {
  local requested="${CPAMP_PROBE_IMPLEMENTATION:-auto}"

  case "${requested}" in
    curl | node)
      printf '%s\n' "${requested}"
      return 0
      ;;
    auto) ;;
    *)
      log_err "Unsupported CPAMP_PROBE_IMPLEMENTATION: ${requested} (expected auto, curl or node)"
      exit 1
      ;;
  esac

  if command -v curl >/dev/null 2>&1; then
    printf 'curl\n'
    return 0
  fi
  if command -v node >/dev/null 2>&1; then
    printf 'node\n'
    return 0
  fi
  printf 'none\n'
}

# http_status_code never places the runtime bearer in a child process argv.
# curl receives the Authorization header through `-K -` (stdin), and the node
# fallback reads it from stdin, so `ps`/`/proc/<pid>/cmdline` cannot capture it.
http_status_code() {
  local url="$1"
  local bearer="${2:-}"
  local extra_header="${3:-}"
  local code=""
  local implementation config

  implementation="$(probe_implementation)"

  if [ "${implementation}" = "curl" ]; then
    config=""
    if [ -n "${bearer}" ]; then
      config="header = \"Authorization: Bearer ${bearer}\""$'\n'
    fi
    if [ -n "${extra_header}" ]; then
      config="${config}header = \"${extra_header}\""$'\n'
    fi
    if [ -n "${config}" ]; then
      code="$(printf '%s' "${config}" | curl -sS -K - -o /dev/null -w '%{http_code}' --max-time 2 --connect-timeout 1 "${url}" 2>/dev/null || true)"
    else
      code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 2 --connect-timeout 1 "${url}" 2>/dev/null || true)"
    fi
    printf '%s\n' "${code:-000}"
    return 0
  fi

  if [ "${implementation}" = "node" ]; then
    code="$(printf '%s' "${bearer}" | CPAMP_PROBE_HEADER="${extra_header}" node -e '
      const http = require("node:http");
      const url = new URL(process.argv[1]);
      const headers = {};
      let token = "";
      process.stdin.on("data", (chunk) => { token += chunk; });
      process.stdin.on("end", () => {
        if (token) headers["Authorization"] = "Bearer " + token;
        const extra = process.env.CPAMP_PROBE_HEADER || "";
        if (extra) {
          const idx = extra.indexOf(":");
          if (idx > 0) headers[extra.slice(0, idx).trim()] = extra.slice(idx + 1).trim();
        }
        const req = http.get(url, { headers, timeout: 1500 }, (res) => {
          res.resume();
          process.stdout.write(String(res.statusCode || "000"));
        });
        req.on("error", () => process.stdout.write("000"));
        req.on("timeout", () => { req.destroy(); process.stdout.write("000"); });
      });
    ' "${url}" 2>/dev/null || true)"
    printf '%s\n' "${code:-000}"
    return 0
  fi

  printf '000\n'
}

detect_cpa_identity() {
  local uid="${CPAMP_RUNTIME_CPA_UID:-}"
  local gid="${CPAMP_RUNTIME_CPA_GID:-}"
  local cpa_user="${CPAMP_CPA_USER:-cpamp-cpa}"

  # The account name reaches `id` (and, from the ctl, `useradd`) as an operand;
  # anything outside a safe POSIX login name is refused outright.
  if ! [[ "${cpa_user}" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
    log_err "Invalid CPAMP_CPA_USER: ${cpa_user} (must match [a-z_][a-z0-9_-]*)"
    exit 1
  fi

  if [ -z "${uid}" ] && [ -z "${gid}" ]; then
    if [ "$(id -u)" -eq 0 ] && [ "$(uname -s)" = "Linux" ]; then
      if id -u "${cpa_user}" >/dev/null 2>&1; then
        uid="$(id -u "${cpa_user}")"
        gid="$(id -g "${cpa_user}")"
      else
        uid="10001"
        gid="10001"
      fi
    fi
  fi

  if [ -z "${uid}" ] && [ -z "${gid}" ]; then
    return 0
  fi

  if [ -z "${uid}" ] || [ -z "${gid}" ]; then
    log_err "CPAMP_RUNTIME_CPA_UID and CPAMP_RUNTIME_CPA_GID must be configured together"
    exit 1
  fi

  case "${uid}" in
    '' | *[!0-9]*)
      log_err "CPAMP_RUNTIME_CPA_UID must be a positive decimal integer"
      exit 1
      ;;
  esac
  case "${gid}" in
    '' | *[!0-9]*)
      log_err "CPAMP_RUNTIME_CPA_GID must be a positive decimal integer"
      exit 1
      ;;
  esac
  if [ "${uid}" -eq 0 ] || [ "${gid}" -eq 0 ]; then
    log_err "The CPA child identity must not be root: CPAMP_RUNTIME_CPA_UID/GID must be non-zero"
    exit 1
  fi
  if [ "$(id -u)" -ne 0 ]; then
    log_err "Dropping CPA to UID ${uid} requires the launcher to run as root"
    exit 1
  fi

  cpa_uid="${uid}"
  cpa_gid="${gid}"
}

# Docker runs the Supervisor as root and drops only CPA. Native matches that
# layout: private Supervisor state stays root-owned (group-readable only where
# the CPA child must traverse it), while the Gateway tree belongs to the CPA
# identity so the child can write its own auth, logs, plugins and config.
#
# NH1: the CPA child is an ordinary unprivileged account, so every directory on
# the path to its config, auth dir and executable needs a traverse bit for
# ${cpa_gid}. In Docker /runtime is `0711 root:root` directly under `/ 0755`;
# natively runtime_root sits inside data_dir, so data_dir is handed to
# `root:${cpa_gid}` with mode `0710` (traverse, never list/read). Manager data
# inside it - usage.sqlite*, data.key, usage-archives and anything else - is
# forced back to `0:0` with `0600`/`0700`.
apply_cpa_ownership() {
  local path manager_data_path

  if [ -z "${cpa_uid}" ]; then
    return 0
  fi

  for path in \
    "${run_dir}" \
    "${log_dir}" \
    "${token_file}" \
    "${runtime_root}" \
    "${supervisor_dir}" \
    "${supervisor_dir}/active" \
    "${supervisor_dir}/active/cpa"; do
    [ -e "${path}" ] || continue
    if ! chown -h 0:0 "${path}"; then
      log_err "Failed to keep ${path} owned by root"
      exit 1
    fi
  done

  for manager_data_path in "${data_dir}"/*; do
    [ -e "${manager_data_path}" ] || continue
    [ "${manager_data_path}" = "${runtime_root}" ] && continue
    if [ -L "${manager_data_path}" ]; then
      log_err "Refusing to continue: ${manager_data_path} is a symlink inside the Manager data directory"
      exit 1
    fi
    if [ -d "${manager_data_path}" ]; then
      # Recursively drop every group/other bit so nothing Manager-owned inside
      # the (now group-traversable) data directory is reachable by cpamp-cpa.
      if ! chown -R -h 0:0 "${manager_data_path}" ||
        ! chmod 0700 "${manager_data_path}" ||
        ! chmod -R go-rwx "${manager_data_path}"; then
        log_err "Failed to keep ${manager_data_path} root-only"
        exit 1
      fi
    else
      if ! chown -h 0:0 "${manager_data_path}" || ! chmod 0600 "${manager_data_path}"; then
        log_err "Failed to keep ${manager_data_path} root-only"
        exit 1
      fi
    fi
  done

  for path in "${supervisor_dir}" "${supervisor_dir}/artifacts" "${supervisor_dir}/artifacts/cpa"; do
    [ -e "${path}" ] || continue
    if ! chown -h 0:"${cpa_gid}" "${path}" || ! chmod 0710 "${path}"; then
      log_err "Failed to hand ${path} to root:${cpa_gid} with mode 0710"
      exit 1
    fi
  done

  for path in \
    "${run_dir}" \
    "${log_dir}" \
    "${supervisor_dir}/active" \
    "${supervisor_dir}/active/cpa"; do
    [ -e "${path}" ] || continue
    chmod 0700 "${path}"
  done
  chmod 0711 "${runtime_root}"
  if ! chown -h 0:"${cpa_gid}" "${data_dir}" || ! chmod 0710 "${data_dir}"; then
    log_err "Failed to make ${data_dir} traversable for group ${cpa_gid} (mode 0710)"
    exit 1
  fi

  # Take the Gateway tree back from the CPA identity while it is mutated, so the
  # child cannot swap entries under root (TOCTOU), then hand it over last.
  reject_symlinks_under "${gateway_dir}"
  if ! chown -h 0:0 "${gateway_dir}" || ! chmod 0700 "${gateway_dir}"; then
    log_err "Failed to take temporary ownership of ${gateway_dir}"
    exit 1
  fi
  for path in "${gateway_dir}" "${gateway_dir}/auth" "${gateway_dir}/logs" "${gateway_dir}/plugins"; do
    [ -d "${path}" ] || continue
    if [ -L "${path}" ] || ! chmod 0700 "${path}"; then
      log_err "Failed to restrict ${path} to the CPA identity"
      exit 1
    fi
  done
  for path in "${gateway_dir}"/*; do
    [ -f "${path}" ] && [ ! -L "${path}" ] || continue
    chmod 0600 "${path}"
  done
  if ! chown -R -h "${cpa_uid}:${cpa_gid}" "${gateway_dir}"; then
    log_err "Failed to hand the Gateway directory ${gateway_dir} to ${cpa_uid}:${cpa_gid}"
    exit 1
  fi
}

