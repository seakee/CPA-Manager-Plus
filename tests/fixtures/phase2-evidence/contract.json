        "evidenceRefs": [
          "client-access-auth",
          "client-config-api-key",
          "frontend-auth-plugin-contract",
          "request-identity-metadata"
        ],
        "limitations": [
          "A FrontendAuthProvider can authenticate or reject and return a principal only when it owns this hook; the request interceptor contract does not directly carry the built-in access principal, and stable caller identity correlation is deferred to Phase2-02."
        ]
