  "requestLifecycle": {
    "canonicalOrder": [
      "request_received",
      "client_api_key_resolved",
      "model_resolved",
      "credential_candidates_generated",
      "disabled_cooldown_priority_filtering",
      "credential_selected",
      "provider_endpoint_resolved",
      "upstream_request_stream",
      "retry_fallback",
      "response_cancel_reject_failure",
      "usage_accounting_settlement"
    ],
    "observedOrderingConstraints": [
      "Client access authentication runs in Gin middleware before the handler creates the request lifecycle tracker or invokes the before-auth request interceptor.",
      "Model normalization and provider-route resolution happen before credential candidate construction; endpoint resolution remains executor-specific after credential selection.",
      "Candidate construction and disabled/cooldown/provider/model/priority filtering are one host selection boundary; a scheduler plugin receives only the already-filtered candidate set.",
      "Retry and fallback re-enter candidate filtering, credential selection, and upstream execution for each attempt.",
      "Usage publication is attempt-coupled inside executors and is not a reservation or settlement contract; no universal ordering after the request terminal callback is proven."
    ],
    "stages": [
      {
        "id": "request_received",
        "ordinal": 0,
        "authPlacement": "before-client-auth",
        "owner": "CPA HTTP server and protocol handler",
        "hostAccess": {
          "observable": true,
          "mutable": true,
          "blockable": true,
          "terminalOnly": false
        },
        "pluginAccess": {
          "observable": true,
          "mutable": false,
          "blockable": true,
          "terminalOnly": false
        },
        "identityMetadata": ["HTTP request", "CPA trace ID when assigned"],
        "artifactScope": ["current-bundled-v7-3-3", "candidate-release-v7-3-8"],
        "evidenceRefs": [
          "client-access-auth",
          "frontend-auth-plugin-contract",
          "handler-request-model"
        ],
        "limitations": [
          "FrontendAuthProvider may observe and reject the inbound HTTP request when configured, but RequestInterceptor is not a raw request-received hook and starts after access authentication and model/provider preparation."
        ]
      },
      {
        "id": "client_api_key_resolved",
        "ordinal": 1,
        "authPlacement": "client-auth",
        "owner": "CPA access manager and configured access provider",
